{
  "name": "rusapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "data": "tsx scripts/pipeline/run.ts && node scripts/verbpairs.mjs",
    "build": "next build && node scripts/gen-sw.mjs",
    "lint": "eslint src shared scripts worker/src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 e2e/app.test.cjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local",
    "worker:migrate:local": "wrangler d1 migrations apply rusapp --local --config worker/wrangler.toml"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-fsrs": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "fake-indexeddb": "^6.0.0",
    "miniflare": "^3.20241106.0",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
